{
  "Application": {
    "DisableSceneOrder": false,
    "OperationMode": "Real",
    "ScenarioAssetsFolder": "assets"
  },
  "Audio": {
    "MediaFolder": "audio",
    "OutputDevice": "auto",
    "DefaultVolume": 80
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning" }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/opt/buttonboard/logs/buttonboard-.clef",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/opt/buttonboard/logs/live.log",
          "shared": true,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 3,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{SourceContext}] ({EventId}-{EventIdName}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Scenario": {
    "Setup": { "Key": "setup" },
    "Scenes": [
      {
        "Key": "scene1",
        "TriggerButton": "TopCenter",
        "RequiredStage": 0
      },
      {
        "Key": "scene2",
        "TriggerButton": "BottomLeft",
        "RequiredStage": 1
      },
      {
        "Key": "scene3",
        "TriggerButton": "BottomCenter",
        "RequiredStage": 2
      },
      {
        "Key": "scene4",
        "TriggerButton": "BottomRight",
        "RequiredStage": 3
      }
    ]
  },
  "OpenHAB": {
    "BaseUri": "http://192.168.20.20:8080/rest/"
  },
  "Lyrion": {
    "BaseUri": "tcp://192.168.20.28:9090",
    "Username": "",
    "Password": ""
  },
  "VLC": {},
  "Lcd": {
    "Enabled": true,
    "FailOnError": false,
    "BusId": 1,
    "Address": 39,
    "Columns": 16,
    "Rows": 2,
    "DefaultBacklight": true
  },
  "Mqtt": {
    "Server": "localhost",
    "Port": 1883,
    "Username": "tbremus",
    "Password": "buttonboard",
    "WillTopic": "buttonboard/status",
    "OnlineTopic": "buttonboard/status"
  }
}
